PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sih26044
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 credentials
# Get these from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI to register: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# LinkedIn OIDC credentials
# Get these from: https://www.linkedin.com/developers/apps → Create App
# Authorized redirect URL to register: http://localhost:5000/api/auth/linkedin/callback
# Required OAuth 2.0 scopes: openid, profile, email
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback
